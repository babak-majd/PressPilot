#: includes/class-pp-admin.php:937
msgid "Enable all"
msgstr "Alle aktivieren"

#: includes/class-pp-admin.php:938
msgid "Disable all"
msgstr "Alle deaktivieren"

#: includes/class-pp-admin.php:956
msgid "Allow code execution"
msgstr "Codeausführung erlauben"

#: includes/class-pp-admin.php:958
msgid "Lets the API run arbitrary PHP — the universal fallback for configuring any plugin."
msgstr "Erlaubt der API, beliebiges PHP auszuführen — der universelle Rückfallweg zur Konfiguration jedes Plugins."

#: includes/class-pp-admin.php:959
msgid "Off by default."
msgstr "Standardmäßig aus."

#. translators: %s: the capability name, formatted as code.
#: includes/class-pp-admin.php:963
#, php-format
msgid "Only enable it if you trust the API key holder completely; it is as powerful as installing a plugin. Requires the %s capability above."
msgstr "Aktiviere es nur, wenn du dem Inhaber des API-Schlüssels vollständig vertraust; es ist so mächtig wie ein Plugin zu installieren. Erfordert die Fähigkeit %s oben."

#. translators: %s: a list of always-available endpoints, formatted as code.
#: includes/class-pp-admin.php:975
#, php-format
msgid "Discovery routes (%s) are always available so an agent can inspect the site."
msgstr "Discovery-Routen (%s) sind immer verfügbar, damit ein Agent die Website prüfen kann."

#: includes/class-pp-admin.php:981
msgid "Save permissions"
msgstr "Berechtigungen speichern"

#: includes/class-pp-admin.php:1003
msgid "Documentation file not found."
msgstr "Dokumentationsdatei nicht gefunden."

#: includes/class-pp-admin.php:1007
