msgstr "(geheim)"

#. translators: %s: the HTTP header name, already formatted as code.
#: includes/class-pp-admin.php:397
#, php-format
msgid ""
"Sent as the %s header. Anyone holding this key can change everything your "
"Permissions allow."
msgstr ""
"Wird als %s-Header gesendet. Wer diesen Schlüssel hat, kann alles ändern, "
"was deine Berechtigungen zulassen."

