msgstr "Transport:"

#: includes/class-pp-admin.php:488
msgid "Streamable HTTP"
msgstr "Streamable HTTP"

#: includes/class-pp-admin.php:490
msgid "Tools exposed:"
msgstr "Bereitgestellte Werkzeuge:"

#: includes/class-pp-admin.php:491
