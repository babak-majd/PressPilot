#: includes/class-pp-admin.php:1087
#, php-format
msgid "When set, only these addresses may use the API; others get %s."
msgstr "عند تعيينها، هذه العناوين فقط يمكنها استخدام API؛ وغيرها يتلقى %s."

#. translators: %s: the visitor's current IP address, formatted as code.
#: includes/class-pp-admin.php:1094
