#: includes/class-pp-admin.php:470
msgid "Model Context Protocol endpoint"
msgstr "نقطهٔ اتصال Model Context Protocol"

#. translators: %s: the number of tools exposed, already wrapped in <strong>.
#: includes/class-pp-admin.php:475
#, php-format
msgid "MCP is the standard way an AI agent plugs into an external system. Point a client at this URL and your site shows up inside it as %s — no prompt engineering, no hand-written HTTP calls. The agent Skill is delivered automatically on connect, so agents follow this site's build rules from their first message."
msgstr "MCP روش استاندارد اتصال یک عامل هوش مصنوعی به یک سامانهٔ بیرونی است. کلاینت خود را به این آدرس وصل کنید تا سایت شما داخل آن به شکل %s ظاهر شود — بدون مهندسی پرامپت و بدون درخواست HTTP دستی. راهنمای عامل هنگام اتصال به‌صورت خودکار تحویل داده می‌شود، پس عامل‌ها از همان پیام اول قواعد ساخت این سایت را رعایت می‌کنند."

#: includes/class-pp-admin.php:476
#, php-format
msgid "%d native tool"
msgid_plural "%d native tools"
msgstr[0] "%d ابزار بومی"
msgstr[1] "%d ابزار بومی"

#: includes/class-pp-admin.php:483
msgid "MCP enabled"
msgstr "MCP فعال"

#: includes/class-pp-admin.php:483
